root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
end_of_line = lf

# PowerShell 5.1 は BOM 無し UTF-8 を ANSI として読む。
# .ps1 は必ず UTF-8 (BOM あり) / CRLF で保存すること。
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
