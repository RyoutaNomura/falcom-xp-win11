# ============================================================================
#  改行と文字コードの固定。理由は docs/05-conventions.md
# ============================================================================

# 既定。テキストは LF で保存し、チェックアウト時も変換しない
* text=auto eol=lf

# --- PowerShell ------------------------------------------------------------
# PowerShell 5.1 は BOM 無し UTF-8 を ANSI として読むため、.ps1 は
# UTF-8 (BOM あり) でなければ日本語が化ける。BOM は単なる内容の
# 一部なので git は触らないが、改行は CRLF に固定しておく。
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# --- Windows のバッチ ------------------------------------------------------
*.cmd text eol=crlf
*.bat text eol=crlf

# --- ddraw プロファイルのテンプレート --------------------------------------
# リポジトリ上は UTF-8 / LF。生成物 (ddraw.ini など) は
# Setup スクリプトが CP932 / CRLF で書き出す。
*.ini.tmpl text eol=lf

# --- ドキュメント ----------------------------------------------------------
*.md text eol=lf

# --- バイナリ --------------------------------------------------------------
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.gif binary
